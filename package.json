{
  "name": "@caf3z1n/astro-route-audit",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Check historical site routes against an Astro build or HTTP preview.",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "astro-route-audit": "bin/cli.js"
  },
  "exports": {
    ".": "./src/astro.js",
    "./audit": "./src/audit.js"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "format:check": "prettier --check src bin test cases/venus-429/replay.js"
  },
  "dependencies": {
    "parse5": "7.3.0",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "prettier": "3.10.1"
  }
}
