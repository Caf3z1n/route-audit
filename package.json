    "cases/venus-429/replay.js",
    "reports",
    "README.md",
    "RESULTS.md"
  ],
  "scripts": {
    "test": "node --test",
    "format:check": "prettier --check src bin test cases/venus-429/replay.js"
  },
  "dependencies": {
    "parse5": "7.3.0",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "prettier": "3.10.1"
