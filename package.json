{
  "name": "route-audit",
  "version": "0.6.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Caf3z1n/route-audit.git"
  },
  "type": "module",
  "description": "Check that your published URLs still work before you deploy.",
  "keywords": [
    "astro-integration",
    "tooling",
    "starlight",
    "sitemap",
    "redirects"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "route-audit": "bin/cli.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./destinations": "./src/destinations.js",
    "./astro": "./src/astro.js",
    "./audit": "./src/audit.js"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "cases/venus-429/README.md",
    "cases/venus-429/package.json",
    "cases/venus-429/package-lock.json",
    "cases/venus-429/*.js",
    "reports",
    "README.md",
    "RESULTS.md",
    "docs",
    ".github/workflows/compare-routes.yml"
  ],
  "scripts": {
    "test": "node --test",
    "format:check": "prettier --check src bin test \"cases/venus-429/*.js\" \"examples/checkers/*.mjs\""
  },
  "dependencies": {
    "parse5": "7.3.0",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "prettier": "3.10.1"
  }
}
